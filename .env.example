# Frontend (Vite) — requeridas
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Scripts Node (bootstrap_catalogo.mjs, sync_imagenes.mjs)
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # solo scripts, NUNCA en el bundle del frontend
DATABASE_URL=postgresql://postgres:[PASS]@db.[REF].supabase.co:5432/postgres

# Shopify
SHOPIFY_STORE=tu-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
SHOPIFY_API_VERSION=2026-01
SHOPIFY_WEBHOOK_SECRET=

# Edge Function shopify-webhook (configurar con `supabase secrets set`, NO en el frontend)
#   SHOPIFY_WEBHOOK_SECRET  -> mismo secreto del webhook de Shopify (firma HMAC)
#   SHOPIFY_UBICACION_ID    -> id de la ubicación de salida/entrada para ventas online
SHOPIFY_UBICACION_ID=

# Edge Function shopify-stock-push (sync inverso almacén → Shopify; secrets del servidor)
#   SYNC_SECRET           -> secreto compartido con el cron (mismo valor en Vault: shopify_sync_secret)
#   SHOPIFY_ADMIN_TOKEN   -> Admin API token con scope write_inventory
#   SHOPIFY_LOCATION_ID   -> id numérico de la location de Shopify
#   (SHOPIFY_STORE y SHOPIFY_API_VERSION se reutilizan de arriba)
SYNC_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_LOCATION_ID=
