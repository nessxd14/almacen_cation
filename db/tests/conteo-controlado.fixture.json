  "triggers": [
    "CREATE TRIGGER kardex_mantiene_stock AFTER INSERT ON public.kardex_transacciones FOR EACH ROW EXECUTE FUNCTION trg_stock_desde_kardex()",
    "CREATE TRIGGER kardex_no_delete BEFORE DELETE ON public.kardex_transacciones FOR EACH ROW EXECUTE FUNCTION trg_kardex_append_only()",
    "CREATE TRIGGER kardex_no_update BEFORE UPDATE ON public.kardex_transacciones FOR EACH ROW EXECUTE FUNCTION trg_kardex_append_only()",
    "CREATE TRIGGER precio_solo_admin BEFORE UPDATE ON public.producto FOR EACH ROW EXECUTE FUNCTION trg_precio_solo_admin()"
  ],
  "functions": [
    "CREATE OR REPLACE FUNCTION public.trg_kardex_append_only()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n    RAISE EXCEPTION 'kardex_transacciones es append-only: % no permitido', TG_OP;\r\nEND;\r\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.trg_stock_desde_kardex()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n    INSERT INTO stock_actual (producto_id, ubicacion_id, cantidad_base, actualizado_en)\r\n    VALUES (NEW.producto_id, NEW.ubicacion_id, NEW.cantidad, now())\r\n    ON CONFLICT (producto_id, ubicacion_id) DO UPDATE\r\n        SET cantidad_base  = stock_actual.cantidad_base + EXCLUDED.cantidad_base,\r\n            actualizado_en = now();\r\n    RETURN NEW;\r\nEND;\r\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.trg_precio_solo_admin()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare v_rol text;\r\nbegin\r\n  if new.precio_base         is not distinct from old.precio_base\r\n and new.precio_mayoreo      is not distinct from old.precio_mayoreo\r\n and new.precio_institucion  is not distinct from old.precio_institucion\r\n and new.precio_corporativo  is not distinct from old.precio_corporativo then\r\n    return new;\r\n  end if;\r\n  v_rol := coalesce(current_setting('request.jwt.claims', true)::jsonb->>'role', 'servidor');\r\n  if v_rol in ('anon','authenticated') and not app_es_admin() then\r\n    raise exception 'Solo un usuario con rol admin puede modificar los precios del catálogo (producto %).', old.id\r\n      using errcode = '42501';\r\n  end if;\r\n  return new;\r\nend $function$\n",
    "CREATE OR REPLACE FUNCTION public.marcar_inventariado(p_producto_id bigint, p_sucursal_id bigint)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare\r\n  v_actor text;\r\nbegin\r\n  if not app_puede_inventariar() then\r\n    raise exception 'Un cajero no puede marcar productos como inventariados.'\r\n      using errcode = '42501';\r\n  end if;\r\n\r\n  v_actor := coalesce(\r\n    (select nombre from perfil where id = auth.uid()),\r\n    auth.jwt() ->> 'email',\r\n    current_user);\r\n\r\n  insert into producto_sucursal (producto_id, sucursal_id, se_vende, control_stock, inventariado_en, inventariado_por)\r\n  values (p_producto_id, p_sucursal_id, true, 'ESTRICTO', now(), v_actor)\r\n  on conflict (producto_id, sucursal_id) do update\r\n    set control_stock   = 'ESTRICTO',\r\n        se_vende        = true,\r\n        inventariado_en = coalesce(producto_sucursal.inventariado_en, now()),\r\n        inventariado_por = coalesce(producto_sucursal.inventariado_por, v_actor);\r\nend;\r\n$function$\n"
  ]
